      <block id="ID74">
        <id>Parametros</id>
        <ml id="ID75">val N_ROBOTS = 2;
          <layout>val N_ROBOTS = 2;</layout>
        </ml>
        <ml id="ID76">val N_SECTORS = 2;
          <layout>val N_SECTORS = 2;</layout>
        </ml>
        <ml id="ID77">val N_CHARGERS = 1;
          <layout>val N_CHARGERS = 1;</layout>
        </ml>
        <ml id="ID78">val BATTERY_LEVELS = 3;
          <layout>val BATTERY_LEVELS = 3;</layout>
        </ml>
      </block>
      <block id="ID79">
        <id>Conjuntos de cores</id>
        <color id="ID80">
          <id>UNIT</id>
          <unit/>
          <layout>colset UNIT = unit;</layout>
        </color>
        <color id="ID81">
          <id>ROBOT</id>
          <index>
            <ml>1</ml>
            <ml>N_ROBOTS</ml>
            <id>rb</id>
          </index>
          <layout>colset ROBOT = index rb with 1..N_ROBOTS;</layout>
        </color>
        <color id="ID82">
          <id>SECTOR</id>
          <int/>
          <layout>colset SECTOR = int with 1..N_SECTORS;</layout>
        </color>
        <color id="ID83">
          <id>LOCATION</id>
          <int/>
          <layout>colset LOCATION = int with 0..N_SECTORS;</layout>
        </color>
        <color id="ID84">
          <id>BATTERY</id>
          <int/>
          <layout>colset BATTERY = int with 0..BATTERY_LEVELS;</layout>
        </color>
        <color id="ID85">
          <id>ROBOT_LOCATION</id>
          <product>
            <id>ROBOT</id>
            <id>LOCATION</id>
          </product>
          <layout>colset ROBOT_LOCATION = product ROBOT * LOCATION;</layout>
        </color>
        <color id="ID86">
          <id>ROBOT_BATTERY</id>
          <product>
            <id>ROBOT</id>
            <id>BATTERY</id>
          </product>
          <layout>colset ROBOT_BATTERY = product ROBOT * BATTERY;</layout>
        </color>
        <color id="ID87">
          <id>ROBOT_SECTOR</id>
          <product>
            <id>ROBOT</id>
            <id>SECTOR</id>
          </product>
          <layout>colset ROBOT_SECTOR = product ROBOT * SECTOR;</layout>
        </color>
      </block>
