      <block id="ID97">
        <id>Marcacoes iniciais</id>
        <ml id="ID98">fun allRobots () = List.tabulate (N_ROBOTS, fn k =&gt; rb(k+1));
          <layout>fun allRobots () = List.tabulate (N_ROBOTS, fn k =&gt; rb(k+1));</layout>
        </ml>
        <ml id="ID99">fun allRobotsAt (p : LOCATION) =
  List.foldl (fn (x,acc) =&gt; acc ++ 1`(x,p)) empty (allRobots());
          <layout>fun allRobotsAt (p : LOCATION) =
  List.foldl (fn (x,acc) =&gt; acc ++ 1`(x,p)) empty (allRobots());</layout>
        </ml>
        <ml id="ID100">fun allBatteriesAt (v : BATTERY) =
  List.foldl (fn (x,acc) =&gt; acc ++ 1`(x,v)) empty (allRobots());
          <layout>fun allBatteriesAt (v : BATTERY) =
  List.foldl (fn (x,acc) =&gt; acc ++ 1`(x,v)) empty (allRobots());</layout>
        </ml>
        <ml id="ID101">fun allChargers () =
  List.foldl (fn (_,acc) =&gt; acc ++ 1`()) empty
             (List.tabulate (N_CHARGERS, fn k =&gt; k));
          <layout>fun allChargers () =
  List.foldl (fn (_,acc) =&gt; acc ++ 1`()) empty
             (List.tabulate (N_CHARGERS, fn k =&gt; k));</layout>
        </ml>
        <ml id="ID102">fun allSectors () =
  List.foldl (fn (k,acc) =&gt; acc ++ 1`k) empty
             (List.tabulate (N_SECTORS, fn k =&gt; k+1));
          <layout>fun allSectors () =
  List.foldl (fn (k,acc) =&gt; acc ++ 1`k) empty
             (List.tabulate (N_SECTORS, fn k =&gt; k+1));</layout>
        </ml>
      </block>
